# 复制为仓库根目录 .env 后填写。不要把真实密码提交进 Git。

API_ADDR=:8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable
# 远端库若禁止在 public 建表，使用自建 schema
DATABASE_SCHEMA=jiaohao
# 可选。留空则只在本进程内广播。多实例时填写，例如 redis://127.0.0.1:6379/0
REDIS_URL=
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=12h
APP_TZ=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# 仅当库中还没有对应角色账号时写入种子用户
ADMIN_STUDENT_ID=admin
ADMIN_PASSWORD=change-me
SEED_DINER_STUDENT_ID=20260001
SEED_DINER_PASSWORD=diner123
SEED_STAFF_STUDENT_ID=staff01
SEED_STAFF_PASSWORD=staff123
